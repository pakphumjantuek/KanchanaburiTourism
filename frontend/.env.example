# Copy this file to ".env" and set the values for your environment.
# Note: VITE_API_BASE_URL must end with a trailing slash.
# Note: VITE_* variables are bundled into the public JavaScript, so never put secrets here.
VITE_API_BASE_URL=http://localhost:5077/api/
VITE_API_BASE_URLS=http://localhost:5077
# Longdo Map key (get your own at https://map.longdo.com and restrict it to your domain)
VITE_LONGDO_KEY=
# Mapbox token for the static map on the place detail page. Create your own at https://account.mapbox.com
# and restrict it to your domain (URL restrictions). Leave empty to hide the static map.
VITE_MAPBOX_TOKEN=
